{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "//": "Scopes carry the tool name and correlation id onto every line.",
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "*",

  "Linnworks": {
    "AuthUrl": "https://api.linnworks.net/api/Auth/AuthorizeByApplication",
    "SessionRefreshBuffer": "00:01:00",
    "HttpTimeout": "00:00:30",
    "MaxRetryAttempts": 3,
    "DefaultRateLimitPerMinute": 150
  },

  "Mcp": {
    "ClientApiKeys": [],
    "AllowDestructiveTools": false,
    "DestructiveToolApiKeys": []
  }
}
