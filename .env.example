# ── Transport Selection ────────────────────────────────────────────────────────
# Allowed values: stdio | http (defaults to http if omitted)
LINNWORKS_MCP_TRANSPORT=http

# ── Server Configuration ───────────────────────────────────────────────────────
PORT=5000
ASPNETCORE_ENVIRONMENT=Production

# ── MCP Client Authorization ─────────────────────────────────────────────────
# Secret API key clients must present, as either header:
#     X-Api-Key: <key>              (what claude.ai sends)
#     Authorization: Bearer <key>
# Generate one with:  openssl rand -hex 32
McpAuth__ApiKey=CHANGE_ME_openssl_rand_hex_32

# Discovery (initialize / tools/list) answers without a key so Claude's connection probe
# succeeds; tool execution always requires one. Set false only if you don't want the tool
# catalogue readable by anyone who has the URL — Claude cannot connect with it off.
McpAuth__AllowAnonymousDiscovery=true

# Set false ONLY if Claude's request-header beta is unavailable to you and you are instead
# restricting the endpoint by IP at Nginx. It disables the API key entirely, so anyone who can
# reach the endpoint can drive the Linnworks account configured below.
McpAuth__RequireApiKey=true

# Whether create/update/delete tools may run at all. Leave false until you want writes.
McpAuth__AllowDestructiveTools=false

# ── Linnworks Configuration (Dual Mode Support) ──────────────────────────────
# 1. Claude Web Connector mode: If client sends NO X-Linnworks-* headers, the server
#    falls back to these default Linnworks credentials.
# 2. SaaS Chatbot mode: If client sends custom X-Linnworks-* headers, the server
#    uses the header credentials per request for multi-tenant users.
Linnworks__AuthUrl=https://api.linnworks.net/api/Auth/AuthorizeByApplication
Linnworks__Stdio__ApplicationId=00000000-0000-0000-0000-000000000000
Linnworks__Stdio__ApplicationSecret=00000000-0000-0000-0000-000000000000
Linnworks__Stdio__Token=00000000-0000-0000-0000-000000000000
